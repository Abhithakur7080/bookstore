{
  "name": "book-store",
  "version": "1.0.0",
  "description": "<h1 align=\"center\" style=\"font-size: 36px;\">\r   <img src=\"./client/src/assets/thumbnail.png\" width=\"35\"/> BOOK STORE\r </h1>",
  "main": "index.js",
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "install:client": "pnpm install --filter client",
    "install:server": "pnpm install --filter book-management-server",
    "install:all": "pnpm install",
    "build:client": "pnpm --filter client build",
    "build:server": "pnpm --filter book-management-server build",
    "build": "pnpm install --prod=false && pnpm run build:client && pnpm run build:server",
    "start": "pnpm --filter book-management-server start",
    "prepare": "husky",
    "commit": "git add . && git-cz"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abhithakur7080/bookstore.git"
  },
  "keywords": [],
  "author": "Abhijeet Kumar",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Abhithakur7080/bookstore/issues"
  },
  "homepage": "https://github.com/Abhithakur7080/bookstore#readme",
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "git-cz": "^4.9.0",
    "husky": "^9.1.7"
  }
}
